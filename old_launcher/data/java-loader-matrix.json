  "era_java_rules": [
    {
      "id": "era-legacy-pre-1.17",
      "description": "Classic, Indev, Infdev, Alpha, Beta, and Release 1.0 through 1.16.5",
      "mc_pattern": "^(rd-|c0\\.|in-|inf-|a1\\.|b1\\.|1\\.([0-9]|1[0-6])(\\.|$))",
      "recommended_major": 8,
      "allowed_majors": [8, 11, 17],
      "mojang_component": "jre-legacy",
      "notes": "Legacy LaunchWrapper and Forge <=1.12.2 strictly require Java 8 due to URLClassLoader and reflection internals."
    },
    {
      "id": "era-1.17",
      "description": "Minecraft 1.17 to 1.17.1",
      "mc_pattern": "^1\\.17(\\.|$)",
      "recommended_major": 16,
      "allowed_majors": [16, 17, 21],
      "mojang_component": "java-runtime-alpha",
      "notes": "Compiled for class file version 60.0 (Java 16); compatible with Java 17."
    },
    {
      "id": "era-1.18-to-1.20.4",
      "description": "Minecraft 1.18 through 1.20.4",
      "mc_pattern": "^1\\.(18|19|20(\\.[0-4])?)$",
      "recommended_major": 17,
      "allowed_majors": [17, 21],
      "mojang_component": "java-runtime-gamma",
      "notes": "Compiled for class file version 61.0 (Java 17)."
    },
    {
      "id": "era-1.20.5-to-1.21.x",
      "description": "Minecraft 1.20.5 through 1.21.x",
      "mc_pattern": "^1\\.(20\\.[5-9]|21(\\.|$))",
      "recommended_major": 21,
      "allowed_majors": [21, 25],
      "mojang_component": "java-runtime-delta",
      "notes": "Compiled for class file version 65.0 (Java 21); supports Generational ZGC."
    },
    {
      "id": "era-26-plus",
      "description": "Minecraft 26.1+ (Year.Drop.Hotfix scheme and 26.x snapshots)",
      "mc_pattern": "^(2[6-9]|[3-9][0-9])\\.",
      "recommended_major": 25,
      "allowed_majors": [25, 26],
      "mojang_component": "java-runtime-epsilon",
      "notes": "Compiled for class file version 69.0 (Java 25); supports JEP 483/514 AOT cache and AppCDS."
    }
  ],
