# Maintainer: Kestryx Contributors <contact@kestryx.dev>
pkgname=kestryx
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast, capable, open-source Minecraft: Java Edition launcher and headless CLI"
arch=('x86_64' 'aarch64')
url="https://github.com/kestryx/kestryx"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'libsecret' 'openssl' 'zlib' 'zstd')
makedepends=('cargo' 'nodejs' 'npm')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p kestryx-cli
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --release --locked --workspace
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/kestryx" "$pkgdir/usr/bin/kestryx"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
