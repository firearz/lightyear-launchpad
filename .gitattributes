# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts must keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.gz    binary
*.zip   binary
*.exe   binary

# Keep GitHub language stats focused on source
docs/**  linguist-documentation
